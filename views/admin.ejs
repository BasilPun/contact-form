<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Manage Jobs' }) %>

    <!-- 2 libraries, jquery has to come first -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>

    <!-- jquery data-tables css -->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel = "stylesheet" href = "/styles/admin-style.css">
</head>
<body>
    <main>
        <h1>Jobs</h1>
        <table id = "admin-table" class = "display">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Job Title</th>
                    <th>Company</th>
                    <th>Linkedin</th>
                    <th>Email Address</th>
                    <th>MeetingType</th>
                    <th>Message</th>
                    <th>Mailing List</th>
                    <th>Email Format</th>
                    <th>Data Created at</th>
                </tr>
            </thead>
            <tbody>
                <% data_input_list.forEach(data_input => { %>
                    <tr>
                        <td><%= data_input['fname'] %></td>
                        <td><%= data_input['lname'] %></td>
                        <td><%= data_input['job-title'] %></td>
                        <td><%= data_input['company'] %></td>
                        <td><%= data_input['linkedin'] %></td>
                        <td><%= data_input['email'] %></td>
                        <td><%= data_input['met'] %></td>
                        <td><%= data_input['met-other'] %></td>
                        <td><%= data_input['message'] %></td>
                        <td><%= data_input['mailing-list'] %></td>
                        <td><%= data_input['email-format'] %></td>
                        <td><%= data_input['timestamp'].toLocaleString()%></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>
<script>
    new DataTable('#admin-table');
 </script>
</body>
</html>